name: krx-data

on:
  schedule:
    # 백업 시계: 주 시계는 외부(cron-job.org) workflow_dispatch 17:23 KST. GitHub cron 2슬롯 백업(비정각)
    # KRX 장 마감(15:30 KST) 이후 — 17:23 / 19:53 KST, 평일
    - cron: "23 8 * * 1-5"
    - cron: "53 10 * * 1-5"
  workflow_dispatch: {}   # 수동 실행 (최초 백필용)

permissions:
  contents: write

concurrency:
  group: krx-data
  cancel-in-progress: false

jobs:
  collect:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - run: pip install -r requirements.txt

      - name: KRX 일봉 수집 (백필/증분 자동)
        run: python pipeline/fetch_krx.py

      - name: 신호 사전점검 (조기 경보 — 집행 16시간 전 이상 감지)
        run: |
          python pipeline/signals_kr.py
          python pipeline/preflight.py kr

      - name: 집행 발화 워치독 (오늘 KR 실집행 마커 확인 → 누락 시 명시적 실패로 이메일 발송, 패치 13 C)
        if: always()
        run: |
          TODAY=$(TZ=Asia/Seoul date +%F)
          # 휴장일이면 워치독 침묵
          python - <<'PY' || exit 0
          import sys; sys.path.insert(0,"pipeline")
          from preflight import is_trading_day
          from datetime import datetime; from zoneinfo import ZoneInfo
          sys.exit(0 if is_trading_day("kr", datetime.now(ZoneInfo("Asia/Seoul")).date()) else 1)
          PY
          LAST=$(cat signals/last_executed_kr.txt 2>/dev/null || echo none)
          if [ "$LAST" = "$TODAY" ]; then
            echo "kr-trade $TODAY 실집행 확인 ✅"
          else
            echo "::error::오늘($TODAY) KR 실집행 마커 없음(마지막 $LAST) — 스케줄·가드 점검 필요"
            exit 1
          fi

      - name: 커밋 & 푸시
        if: always()
        run: |
          git config user.name "quant-krx-bot"
          git config user.email "actions@github.com"
          git pull --rebase || true
          git add data
          git diff --cached --quiet && echo "변경 없음" && exit 0
          git commit -m "krx: $(date -u +%F) 자동 수집"
          git push
